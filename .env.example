# ===========================
# Backend Configuration
# ===========================
APP_NAME=Cybersecurity Trainer Task Manager
APP_VERSION=0.1.0
DEBUG=true
SECRET_KEY=change-me-in-production-use-a-strong-random-key

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cyber_trainer

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# API
API_V1_PREFIX=/api/v1

# ===========================
# Frontend Configuration
# ===========================
VITE_API_BASE_URL=http://localhost:8000

# ===========================
# PostgreSQL (Docker)
# ===========================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cyber_trainer

# ===========================
# Google Sheets (Session 18+)
# ===========================
# GOOGLE_CREDENTIALS_PATH=
# GOOGLE_SPREADSHEET_ID=
